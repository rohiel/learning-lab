# Copy to .env and fill in. NEVER commit the real .env.
# ---- Secrets / Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx   # required to actually generate questions
ANTHROPIC_MODEL=claude-sonnet-4-6                   # preserved from tutor_app.html; bump later if desired
ANTHROPIC_TIMEOUT=60                                # seconds for quick calls (grading/help)
ANTHROPIC_MAX_RETRIES=2
GENERATION_TIMEOUT=180                              # seconds for question generation (slow, reasoning-heavy)
GENERATION_RETRIES=3                                # retries w/ exponential backoff (2s,4s,8s) on transient errors
LOG_LEVEL=INFO                                      # generation timing + retry logs

# ---- API auth (one-family shared secret) ----
# The frontend sends this as the `X-API-Key` header on every request.
API_SHARED_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# SQLite to start; swap to e.g. postgresql+psycopg://user:pass@host/db with zero model changes.
DATABASE_URL=sqlite:///./data/tutor.db

# ---- Nightly scheduler ----
SCHEDULER_ENABLED=true          # set false to run the API without the background job
SCHEDULER_TZ=America/New_York   # DST-aware Eastern, so the job is always ~8 PM her time
SCHEDULER_HOUR=20               # 24h local time

# ---- First-run convenience ----
AUTO_SEED_POOLS=false           # true => background-seed pools on boot (app stays reachable)
AUTO_SEED_WEEK=1
AUTO_SEED_DAYS=1,2,3

# ---- CORS ----
# Comma-separated allowed origins for the frontend. Use * only for local dev.
FRONTEND_ORIGIN=*

# ---- Question-pool sizing (5-7 per level x 5 levels = ~25-35/day) ----
PER_LEVEL_MIN=5
PER_LEVEL_MAX=7
