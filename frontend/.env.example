# Base URL of the backend API.
# Dev: point at the FastAPI server. Prod (same domain): use /api
VITE_API_BASE=http://localhost:8000/api

# Shared secret — must match the backend API_SHARED_SECRET.
# NOTE: this is baked into the built SPA and visible to anyone who loads the
# page. It deters casual access; it is not strong auth (one-family app).
VITE_API_SECRET=change-me-to-a-long-random-string

# Optional: pin a student id. If unset, the app uses the first student.
# VITE_STUDENT_ID=1
