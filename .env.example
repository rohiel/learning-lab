# Root env for docker-compose / single-container deploy. Copy to .env.
# (The backend has its own backend/.env.example for running uvicorn directly.)

# Required
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
API_SHARED_SECRET=change-me-to-a-long-random-string

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-4-6
SCHEDULER_TZ=America/New_York
SCHEDULER_HOUR=20
